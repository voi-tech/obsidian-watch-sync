{
  "name": "obsidian-watch-sync",
  "version": "26.8.6",
  "description": "Import a Stremio or Nuvio library, watch history, and progress into customizable movie and series notes.",
  "author": "voitech",
  "license": "MIT",
  "main": "main.js",
  "homepage": "https://github.com/voi-tech/obsidian-watch-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voi-tech/obsidian-watch-sync.git"
  },
  "bugs": {
    "url": "https://github.com/voi-tech/obsidian-watch-sync/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "stremio",
    "nuvio",
    "movies",
    "series"
  ],
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:mobile-bundle && npm run release:check",
    "check:mobile-bundle": "node scripts/check-mobile-bundle.mjs",
    "release:check": "node scripts/check-release.mjs",
    "version": "node scripts/version-bump.mjs"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "pako": "^1.0.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.20.1",
    "builtin-modules": "^4.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "esbuild": "^0.28.1",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.10"
  }
}
